# Copy to .env (gitignored) and source it, or export directly, before running
# `mcphound registry-poll`, `alembic upgrade head`, or the DB-backed tests.
MCPHOUND_DATABASE_URL=postgresql+psycopg://mcphound:mcphound@localhost:5432/mcphound_dev

# Base URL the read-only API (src/mcphound/api/app.py) uses to build badge and
# report URLs. Optional — defaults to https://mcphound.dev. Point it at
# http://localhost:8000 (or wherever you're running `uvicorn`) for local dev.
MCPHOUND_SITE_BASE_URL=http://localhost:8000
